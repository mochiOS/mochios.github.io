---
import Base from "../layouts/Base.astro";
import "../styles/scroll.css";
---

<Base>
    <section class="hero">
        <div class="hero-content">
            <h1>The computer,<br />made personal again.</h1>

            <div class="hero-points" aria-label="mochiOS values">
                <span>Free.</span>
                <span>Reassurance.</span>
                <span>You're own computer! ;)</span>
            </div>

            <div class="hero-actions">
                <a class="button primary" href="#about">About</a>
                <a class="button secondary" href="https://developer.mochios.org">
                    for Developers
                </a>
            </div>
        </div>
    </section>

    <section class="section intro-section" id="about">
        <div class="section-heading">
            <h2>A completely new operating system built from scratch.</h2>
        </div>

        <div class="word-stack">
            <span>Kernel,</span>
            <span>System Service,</span>
            <span>and GUI</span>
            <span>We created everything ourselves.</span>
        </div>
    </section>

    <section class="feature-band">
        <div class="feature-inner">
            <div class="feature-heading">
                <p class="section-kicker">Security</p>
                <h2>Isolation.<br />Least privilege.<br />and Recovery.</h2>
            </div>

            <div class="word-stack compact">
                <span>Application is broken?</span>
                <span>Service is broken?</span>
                <span>Driver is broken?</span>
                <span>They possess only the necessary permissions.</span>
                <span class="accent-line">If one thing breaks, not everything breaks.</span>

                <a class="text-link" href="https://developer.mochios.org">
                    View the design <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>

    <section class="section system-section">
        <div class="section-heading">
            <h2>For the things you use every day.<br />Make it more natural.</h2>
        </div>
        <div class="system-grid">
            <article class="system-card">
                <span class="card-number">01</span>
                <h3>Simple</h3>
                <p>Annoying notifications? A confusing, complex UI? You won't find any of that here.</p>
            </article>

            <article class="system-card">
                <span class="card-number">02</span>
                <h3>Seamless</h3>
                <p>Other operating systems pursue more and more features. mochiOS pursues ease of use.</p>
            </article>

            <article class="system-card">
                <span class="card-number">03</span>
                <h3>Personal</h3>
                <p>A computer for you!</p>
            </article>
        </div>
    </section>


    <section class="open-section">
        <div class="open-inner">
            <p class="section-kicker">Open source</p>
            <h2>Anyone can participate in the development!</h2>
            <p>No prior knowledge? No problem! With mochiOS Developer, beginners can start from the basics of the OS,<br />learn how to develop for it, and even go on to contribute to the OS itself. and all free!</p>
            <div class="open-list marquee-track">
                <div class="open-list marquee-group">
                    <span>mnu</span>
                    <span>Viewkit</span>
                    <span>Applications</span>
                    <span>Devkit</span>
                    <span>Desktop</span>
                    <span>Design</span>
                    <span>developer CA server</span>
                    <span>AppStore Server</span>
                    <span>DeveloperConsole</span>
                </div>
                <div class="open-list marquee-group">
                    <span>mnu</span>
                    <span>Viewkit</span>
                    <span>Applications</span>
                    <span>Devkit</span>
                    <span>Desktop</span>
                    <span>Design</span>
                    <span>developer CA server</span>
                    <span>AppStore Server</span>
                    <span>DeveloperConsole</span>
                </div>
            </div>

            <div class="open-actions">
                <a class="button primary" href="https://github.com/mochiOS">
                    GitHub
                </a>
                <a class="button secondary" href="https://www.mochios.org/contribute.html">
                    Contribute
                </a>
            </div>
        </div>
    </section>

    <section class="section preview-section">
        <div class="preview-card">
            <div>
                <p class="section-kicker">Developer Preview</p>
                <h2>mochiOS 26.0<br />Kinako</h2>
            </div>

            <div class="preview-side">
                <p>Currently under development. Coming soon!</p>
                <a class="text-link" href="https://developer.mochios.org">
                    mochiOS Developer <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>
</Base>
