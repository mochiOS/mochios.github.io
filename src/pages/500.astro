---
import Base from "../layouts/Base.astro";
import "../styles/scroll.css";
---

<Base>
    <section class="hero">
        <div class="hero-content">
            <h1>500 Internal server error</h1>

            <div class="hero-points" aria-label="mochiOS values">
                <span>We apologize. an unexpected issue has occurred on the server.</span>
            </div>

            <div class="hero-actions">
                <button onclick="history.back()" class="button secondary">Return to the previous page</button>
            </div>
        </div>
    </section>
</Base>
