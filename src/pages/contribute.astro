---
import Base from "../layouts/Base.astro";
---

<Base
    title="Contribute — mochiOS"
    description="Help build mochiOS through code, design, documentation, testing, and more."
>
    <section class="contribute-hero">
        <div class="contribute-hero-inner">
            <p class="section-kicker">Contribute</p>

            <h1>
                Build mochiOS
                <br />
                with us.
            </h1>

            <p class="contribute-lead">
                mochiOS is built in the open.
                <br />
                You can contribute through code, design, documentation, testing,
                and more.
            </p>

            <div class="contribute-actions">
                <a class="button primary" href="https://github.com/mochiOS">
                    Explore on GitHub
                </a>

                <a class="button secondary" href="#ways">
                    Find your place
                </a>
            </div>
        </div>
    </section>

    <section class="section ways-section" id="ways">
        <div class="section-heading">
            <p class="section-kicker">Find your place</p>
            <h2>There is more than one way to contribute.</h2>
        </div>

        <div class="contribution-grid">
            <article class="contribution-card">
                <span class="card-number">01</span>
                <h3>Code</h3>
                <p>
                    Build the kernel, system services, applications, drivers,
                    and developer tools.
                </p>

                <a class="text-link" href="https://github.com/mochiOS">
                    Explore projects <span aria-hidden="true">→</span>
                </a>
            </article>

            <article class="contribution-card">
                <span class="card-number">02</span>
                <h3>Design</h3>
                <p>
                    Help shape interfaces, interactions, icons, and the visual
                    language of mochiOS.
                </p>

                <a
                    class="text-link"
                    href="https://developer.mochios.org/design"
                >
                    Explore design <span aria-hidden="true">→</span>
                </a>
            </article>

            <article class="contribution-card">
                <span class="card-number">03</span>
                <h3>Documentation</h3>
                <p>
                    Make mochiOS easier to understand, learn, and develop for.
                </p>

                <a class="text-link" href="https://developer.mochios.org">
                    Read documentation <span aria-hidden="true">→</span>
                </a>
            </article>

            <article class="contribution-card">
                <span class="card-number">04</span>
                <h3>Testing</h3>
                <p>
                    Try mochiOS, find problems, reproduce bugs, and help make
                    the system more reliable.
                </p>

                <a
                    class="text-link"
                    href="https://github.com/orgs/mochiOS/repositories"
                >
                    Explore repositories <span aria-hidden="true">→</span>
                </a>
            </article>
        </div>
    </section>

    <section class="projects-band">
        <div class="projects-inner">
            <div class="projects-heading">
                <p class="section-kicker">Projects</p>

                <h2>
                    Choose what
                    <br />
                    you want to build.
                </h2>
            </div>

            <div class="project-list">
                <a href="https://github.com/mochiOS/mnu">
                    <div>
                        <h3>mnu</h3>
                        <p>Kernel</p>
                    </div>

                    <span aria-hidden="true">→</span>
                </a>

                <a href="https://github.com/mochiOS/ViewKit">
                    <div>
                        <h3>ViewKit</h3>
                        <p>User interface framework</p>
                    </div>

                    <span aria-hidden="true">→</span>
                </a>

                <a href="https://github.com/mochiOS/services">
                    <div>
                        <h3>System Services</h3>
                        <p>Core userspace services</p>
                    </div>

                    <span aria-hidden="true">→</span>
                </a>

                <a href="https://github.com/mochiOS/drivers">
                    <div>
                        <h3>Drivers</h3>
                        <p>Hardware support</p>
                    </div>

                    <span aria-hidden="true">→</span>
                </a>

                <a href="https://github.com/mochiOS/devkit">
                    <div>
                        <h3>Developer Tools</h3>
                        <p>Tools for building software for mochiOS</p>
                    </div>

                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>

    <section class="section beginner-section">
        <div class="beginner-card">
            <div>
                <p class="section-kicker">New to OS development?</p>

                <h2>That's okay.</h2>
            </div>

            <div class="beginner-copy">
                <p>
                    You do not need to know everything before you start. Learn
                    how mochiOS works, choose a part that interests you, and
                    start small.
                </p>

                <a class="text-link" href="https://developer.mochios.org">
                    Start learning <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>

    <section class="process-section">
        <div class="process-inner">
            <div class="section-heading">
                <p class="section-kicker">How it works</p>
                <h2>From an idea to mochiOS.</h2>
            </div>

            <div class="process-grid">
                <article>
                    <span>01</span>
                    <h3>Choose</h3>
                    <p>Find a project or problem that interests you.</p>
                </article>

                <article>
                    <span>02</span>
                    <h3>Understand</h3>
                    <p>Read the relevant documentation and existing code.</p>
                </article>

                <article>
                    <span>03</span>
                    <h3>Build</h3>
                    <p>Make your change and test it locally.</p>
                </article>

                <article>
                    <span>04</span>
                    <h3>Contribute</h3>
                    <p>Submit your work for review.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="final-section">
        <div class="final-inner">
            <p class="section-kicker">Open source</p>

            <h2>
                Build something
                <br />
                with us.
            </h2>

            <p>
                Every part of mochiOS exists because someone decided to make it
                better.
            </p>

            <div class="contribute-actions">
                <a class="button primary" href="https://github.com/mochiOS">
                    Explore projects
                </a>

                <a
                    class="button secondary"
                    href="https://developer.mochios.org"
                >
                    Developer
                </a>
            </div>
        </div>
    </section>
</Base>

<style>
    .contribute-hero {
        min-height: 620px;
        padding: 128px 24px 120px;
        display: grid;
        place-items: center;
        text-align: center;
        border-bottom: 1px solid var(--line);
    }

    .contribute-hero-inner {
        max-width: 980px;
    }

    .contribute-hero h1 {
        margin: 12px 0 0;
        font-size: clamp(58px, 8vw, 104px);
        font-weight: 760;
        line-height: 0.96;
        letter-spacing: -0.067em;
    }

    .contribute-lead {
        max-width: 700px;
        margin: 34px auto 0;
        color: var(--ink-secondary);
        font-size: clamp(19px, 2vw, 24px);
        font-weight: 500;
        letter-spacing: -0.025em;
    }

    .contribute-actions {
        margin-top: 34px;
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .ways-section {
        padding-top: 112px;
        padding-bottom: 120px;
    }

    .contribution-grid {
        margin-top: 64px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        border-top: 1px solid var(--line);
    }

    .contribution-card {
        min-height: 300px;
        padding: 32px 36px 36px 0;
        border-bottom: 1px solid var(--line);
    }

    .contribution-card:nth-child(even) {
        padding-left: 36px;
        border-left: 1px solid var(--line);
    }

    .contribution-card h3 {
        margin: 42px 0 12px;
        font-size: 30px;
        letter-spacing: -0.04em;
    }

    .contribution-card p {
        max-width: 460px;
        margin: 0;
        color: var(--ink-secondary);
        font-size: 17px;
    }

    .projects-band {
        background: var(--surface);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .projects-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 112px 24px;
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: 96px;
    }

    .projects-heading h2 {
        margin: 8px 0 0;
        font-size: clamp(40px, 5vw, 64px);
        line-height: 1.02;
        letter-spacing: -0.052em;
    }

    .project-list {
        border-top: 1px solid var(--line);
    }

    .project-list a {
        min-height: 104px;
        padding: 24px 4px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        border-bottom: 1px solid var(--line);
        text-decoration: none;
        transition: color 120ms ease;
    }

    .project-list a:hover {
        color: var(--blue);
    }

    .project-list h3 {
        margin: 0;
        font-size: 24px;
        letter-spacing: -0.035em;
    }

    .project-list p {
        margin: 5px 0 0;
        color: var(--ink-secondary);
        font-size: 15px;
    }

    .project-list a > span {
        font-size: 20px;
    }

    .beginner-section {
        padding-top: 96px;
        padding-bottom: 96px;
    }

    .beginner-card {
        padding: 52px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 72px;
        align-items: end;
        background: var(--surface-soft);
        border: 1px solid var(--line);
        border-radius: 28px;
    }

    .beginner-card h2 {
        font-size: clamp(42px, 5vw, 64px);
    }

    .beginner-copy {
        color: var(--ink-secondary);
        font-size: 17px;
    }

    .beginner-copy p {
        margin: 0;
    }

    .process-section {
        border-top: 1px solid var(--line);
    }

    .process-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 112px 24px;
    }

    .process-grid {
        margin-top: 64px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid var(--line);
    }

    .process-grid article {
        padding: 28px 24px 0 0;
        min-height: 230px;
    }

    .process-grid article + article {
        padding-left: 24px;
        border-left: 1px solid var(--line);
    }

    .process-grid span {
        color: var(--ink-tertiary);
        font-size: 12px;
        letter-spacing: 0.08em;
    }

    .process-grid h3 {
        margin: 42px 0 10px;
        font-size: 24px;
        letter-spacing: -0.035em;
    }

    .process-grid p {
        margin: 0;
        color: var(--ink-secondary);
        font-size: 15px;
    }

    .final-section {
        padding: 120px 24px;
        background: var(--surface-soft);
        border-top: 1px solid var(--line);
        text-align: center;
    }

    .final-inner {
        max-width: 820px;
        margin: 0 auto;
    }

    .final-inner h2 {
        margin: 8px 0 0;
        font-size: clamp(48px, 6vw, 78px);
        line-height: 0.98;
        letter-spacing: -0.058em;
    }

    .final-inner > p:last-of-type {
        margin: 28px auto 0;
        max-width: 560px;
        color: var(--ink-secondary);
        font-size: 18px;
    }

    @media (max-width: 760px) {
        .contribute-hero {
            min-height: 560px;
            padding: 96px 20px 88px;
        }

        .contribute-hero h1 {
            font-size: clamp(52px, 15vw, 76px);
        }

        .contribute-lead br {
            display: none;
        }

        .contribution-grid {
            grid-template-columns: 1fr;
        }

        .contribution-card,
        .contribution-card:nth-child(even) {
            min-height: auto;
            padding: 28px 0 36px;
            border-left: 0;
        }

        .projects-inner {
            padding: 86px 20px;
            grid-template-columns: 1fr;
            gap: 48px;
        }

        .beginner-card {
            padding: 32px;
            grid-template-columns: 1fr;
            gap: 32px;
            border-radius: 22px;
        }

        .process-inner {
            padding: 86px 20px;
        }

        .process-grid {
            grid-template-columns: 1fr;
        }

        .process-grid article,
        .process-grid article + article {
            min-height: auto;
            padding: 26px 0 32px;
            border-left: 0;
            border-bottom: 1px solid var(--line);
        }

        .process-grid h3 {
            margin-top: 24px;
        }

        .final-section {
            padding: 92px 20px;
        }
    }
</style>
