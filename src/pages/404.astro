---
import Base from "../layouts/Base.astro";
import "../styles/scroll.css";
---

<Base>
    <section class="hero">
        <div class="hero-content">
            <h1>404 Not found :(</h1>

            <div class="hero-points" aria-label="mochiOS values">
                <span>sorry, This page does not exist!</span>
            </div>

            <div class="hero-actions">
                <button onclick="history.back()" class="button secondary">Return to the previous page</button>
            </div>
        </div>
    </section>
</Base>
